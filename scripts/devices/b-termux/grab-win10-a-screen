#!/data/data/com.termux/files/usr/bin/sh
set -eu

base_url="${STREAMOPS_NODE_URL:-http://192.168.1.8:8765}"
output="${1:-$HOME/storage/shared/Pictures/streamops-screen.png}"
temporary="${output}.tmp.$$"

mkdir -p "$(dirname "$output")"
trap 'rm -f "$temporary"' EXIT HUP INT TERM

curl --fail-with-body --silent --show-error \
  --request POST \
  --header 'Cache-Control: no-cache' \
  "${base_url}/api/v1/screen/capture" >/dev/null

curl --fail-with-body --silent --show-error \
  --header 'Cache-Control: no-cache' \
  --output "$temporary" \
  "${base_url}/api/v1/screen/latest?v=$(date +%s)"

mv "$temporary" "$output"
trap - EXIT HUP INT TERM
printf '%s\n' "$output"
