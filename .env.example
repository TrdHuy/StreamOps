OBS_WEBSOCKET_HOST=127.0.0.1
OBS_WEBSOCKET_PORT=4455
# Set only when OBS WebSocket authentication is enabled.
OBS_WEBSOCKET_PASSWORD=

# Optional: point installed streamops commands at this repo when not run from repo root.
# STREAMOPS_HOME=C:\Users\huy\codex-work\StreamOps

# StreamOps node server. CLI flags override these values.
STREAMOPS_NODE_HOST=0.0.0.0
STREAMOPS_NODE_PORT=8765
STREAMOPS_NODE_OUTPUT_INDEX=0
# Must remain inside this repository. Default: .streamops\node
# STREAMOPS_NODE_DATA_DIR=.streamops\node
STREAMOPS_NODE_CAPTURE_TIMEOUT=3
STREAMOPS_NODE_LOG_LEVEL=info
